.editor-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  position: relative;
}

.topbar {
  position: absolute;
  top: 16rpx;
  left: 0;
  right: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  z-index: 20;
}

.top-close { color: var(--text-2); font-size: 32rpx; }

.top-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text);
}

.top-export {
  background: var(--accent);
  color: var(--on-accent);
  font-size: 26rpx;
  font-weight: 500;
  padding: 10rpx 24rpx;
  border-radius: 16rpx;
}

/* 照片画布 */
.canvas {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 140rpx 40rpx 24rpx;
}

.photo {
  width: 100%;
  max-height: 100%;
  border-radius: 8rpx;
  transition: transform 0.25s ease;
}

/* 边框样式：真实作用于照片容器 */
.border-0 { border: none; padding: 0; }
.border-1 { border: solid #FFFFFF; padding: 0; box-shadow: inset 0 0 0 0; }
.border-2 { border: solid #000000; padding: 0; }
.border-3 { border-radius: 32rpx; }
.border-4 { background: #FFFFFF; padding: 0 12rpx 60rpx; }

.watermark {
  position: absolute;
  right: 60rpx;
  bottom: 90rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  text-shadow: 0 0 8rpx rgba(0, 0, 0, 0.4);
}

/* 功能面板：从工具栏上方滑出 */
.panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 192rpx;
  max-height: 640rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  border-radius: 48rpx 48rpx 0 0;
  padding: 24rpx 32rpx 32rpx;
  transform: translateY(120%);
  transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  overflow-y: auto;
  z-index: 10;
  box-sizing: border-box;
}

.panel-open { transform: translateY(0); }

.chips {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.chip {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  background: var(--bg);
  border: 1rpx solid var(--hairline);
  font-size: 26rpx;
  color: var(--text-2);
}

.chip-on {
  background: var(--accent);
  color: var(--on-accent);
  border-color: var(--accent);
  font-weight: 500;
}

.slider-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4rpx;
}

.s-label { font-size: 26rpx; color: var(--text); }

.s-val { font-size: 24rpx; color: var(--text-2); }

.hint {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}

/* 滤镜缩略行 */
.filter-scroll { white-space: nowrap; margin-bottom: 12rpx; }

.filter-row { display: inline-flex; gap: 20rpx; }

.filter-item { display: inline-flex; flex-direction: column; align-items: center; gap: 8rpx; }

.filter-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  background: var(--bg);
  border: 2rpx solid var(--hairline);
  color: var(--text-2);
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-on { border-color: var(--accent); border-width: 4rpx; }

.filter-name { font-size: 22rpx; color: var(--text-2); }

/* 水印位置九宫格 */
.watermark-preview { font-size: 26rpx; color: var(--text); margin-bottom: 16rpx; }

.pos-grid { margin-bottom: 16rpx; }

.pos-row { display: flex; gap: 8rpx; margin-bottom: 8rpx; }

.pos-cell {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--hairline);
  background: var(--bg);
}

.pos-on { background: var(--accent); border-color: var(--accent); }

/* 文字输入 */
.text-input {
  height: 80rpx;
  border-radius: 16rpx;
  background: var(--bg);
  border: 1rpx solid var(--hairline);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text);
  margin-bottom: 20rpx;
}

/* 底部常驻横向工具栏 */
.toolbar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 192rpx;
  display: flex;
  background: var(--bg);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 15;
}

.tool {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.tool-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  border: 3rpx solid var(--text-2);
  color: var(--text-2);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.tool-on .tool-icon {
  border-color: var(--accent);
  color: var(--accent);
}

.tool-label {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-2);
}

.tool-on .tool-label { color: var(--accent); }

/* ---------- 画布叠加层 ---------- */
.canvas { position: relative; overflow: hidden; }

.anchor {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  margin-left: -8rpx;
  margin-top: -8rpx;
  border-radius: 50%;
  background: rgba(245, 245, 247, 0.45);
  z-index: 6;
}

.cross-v {
  position: absolute;
  left: 50%;
  top: 0;
  width: 1rpx;
  height: 100%;
  background: rgba(245, 245, 247, 0.35);
  z-index: 5;
}

.cross-h {
  position: absolute;
  top: 50%;
  left: 0;
  height: 1rpx;
  width: 100%;
  background: rgba(245, 245, 247, 0.35);
  z-index: 5;
}

.wm {
  position: absolute;
  font-size: 24rpx;
  color: #FFFFFF;
  text-shadow: 0 0 8rpx rgba(0, 0, 0, 0.5);
  z-index: 7;
}

.wm-0, .wm-3, .wm-6 { left: 24rpx; }
.wm-1, .wm-4, .wm-7 { left: 50%; transform: translateX(-50%); }
.wm-2, .wm-5, .wm-8 { right: 24rpx; text-align: right; }
.wm-0, .wm-1, .wm-2 { top: 24rpx; }
.wm-3, .wm-4, .wm-5 { top: 50%; transform: translateY(-50%); }
.wm-6, .wm-7, .wm-8 { bottom: 24rpx; }

.movable-area {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 8;
  pointer-events: none;
}

.element {
  position: absolute;
  width: 192rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
}

.el-text {
  color: #FFFFFF;
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.22);
}

.el-sticker {
  font-size: 36rpx;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.32);
  color: #FFFFFF;
}

.element-on {
  outline: 2rpx solid var(--accent);
  border-radius: 8rpx;
}

.snapped-chip {
  position: absolute;
  left: 50%;
  bottom: 24rpx;
  transform: translateX(-50%);
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  background: var(--accent);
  color: var(--on-accent);
  font-size: 22rpx;
  z-index: 9;
}

/* ---------- 裁剪框 ---------- */
.crop-mask {
  position: absolute;
  background: rgba(0, 0, 0, 0.45);
  z-index: 6;
}

.crop-top { left: 0; top: 0; right: 0; }
.crop-bottom { left: 0; right: 0; bottom: 0; }
.crop-left { left: 0; }
.crop-right { right: 0; }

.crop-frame {
  position: absolute;
  border: 2rpx solid #FFFFFF;
  z-index: 7;
}

.third {
  position: absolute;
  background: rgba(255, 255, 255, 0.4);
}

.third-v1 { left: 33.33%; top: 0; width: 1rpx; height: 100%; }
.third-v2 { left: 66.66%; top: 0; width: 1rpx; height: 100%; }
.third-h1 { top: 33.33%; left: 0; height: 1rpx; width: 100%; }
.third-h2 { top: 66.66%; left: 0; height: 1rpx; width: 100%; }

.handle {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--accent);
  border: 4rpx solid rgba(0, 0, 0, 0.4);
}

.handle-lt { left: -14rpx; top: -14rpx; }
.handle-rt { right: -14rpx; top: -14rpx; }
.handle-lb { left: -14rpx; bottom: -14rpx; }
.handle-rb { right: -14rpx; bottom: -14rpx; }

/* ---------- 贴纸行 ---------- */
.sticker-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.sticker {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--bg);
  border: 1rpx solid var(--hairline);
  color: var(--text);
  font-size: 32rpx;
}

/* ---------- 工具图标（手绘线性） ---------- */
.tool-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.65;
}

.tool-on .tool-icon { opacity: 1; }

.top-close {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.65;
}

.original-badge {
  position: absolute;
  left: 50%;
  top: 24rpx;
  transform: translateX(-50%);
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 22rpx;
  z-index: 12;
}

.filter-img {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

.filter-fallback {
  font-size: 36rpx;
  color: var(--text-2);
}
