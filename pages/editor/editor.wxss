.editor-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  position: relative;
}

.topbar {
  position: absolute;
  top: 16rpx;
  left: 0;
  right: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  z-index: 20;
}

.top-close { color: var(--text-2); font-size: 32rpx; }

.top-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text);
}

.top-export {
  background: var(--accent);
  color: var(--on-accent);
  font-size: 26rpx;
  font-weight: 500;
  padding: 10rpx 24rpx;
  border-radius: 16rpx;
}

/* 照片画布 */
.canvas {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 140rpx 40rpx 24rpx;
}

.photo {
  width: 100%;
  max-height: 100%;
  border-radius: 8rpx;
  transition: transform 0.25s ease;
}

/* 边框样式：真实作用于照片容器 */
.border-0 { border: none; padding: 0; }
.border-1 { border: solid #FFFFFF; padding: 0; box-shadow: inset 0 0 0 0; }
.border-2 { border: solid #000000; padding: 0; }
.border-3 { border-radius: 32rpx; }
.border-4 { background: #FFFFFF; padding: 0 12rpx 60rpx; }

.watermark {
  position: absolute;
  right: 60rpx;
  bottom: 90rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  text-shadow: 0 0 8rpx rgba(0, 0, 0, 0.4);
}

/* 功能面板：从工具栏上方滑出 */
.panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 192rpx;
  max-height: 640rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  border-radius: 48rpx 48rpx 0 0;
  padding: 24rpx 32rpx 32rpx;
  transform: translateY(120%);
  transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  overflow-y: auto;
  z-index: 10;
  box-sizing: border-box;
}

.panel-open { transform: translateY(0); }

.chips {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.chip {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  background: var(--bg);
  border: 1rpx solid var(--hairline);
  font-size: 26rpx;
  color: var(--text-2);
}

.chip-on {
  background: var(--accent);
  color: var(--on-accent);
  border-color: var(--accent);
  font-weight: 500;
}

.slider-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4rpx;
}

.s-label { font-size: 26rpx; color: var(--text); }

.s-val { font-size: 24rpx; color: var(--text-2); }

.hint {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}

/* 滤镜缩略行 */
.filter-scroll { white-space: nowrap; margin-bottom: 12rpx; }

.filter-row { display: inline-flex; gap: 20rpx; }

.filter-item { display: inline-flex; flex-direction: column; align-items: center; gap: 8rpx; }

.filter-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  background: var(--bg);
  border: 2rpx solid var(--hairline);
  color: var(--text-2);
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-on { border-color: var(--accent); border-width: 4rpx; }

.filter-name { font-size: 22rpx; color: var(--text-2); }

/* 水印位置九宫格 */
.watermark-preview { font-size: 26rpx; color: var(--text); margin-bottom: 16rpx; }

.pos-grid { margin-bottom: 16rpx; }

.pos-row { display: flex; gap: 8rpx; margin-bottom: 8rpx; }

.pos-cell {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--hairline);
  background: var(--bg);
}

.pos-on { background: var(--accent); border-color: var(--accent); }

/* 文字输入 */
.text-input {
  height: 80rpx;
  border-radius: 16rpx;
  background: var(--bg);
  border: 1rpx solid var(--hairline);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text);
  margin-bottom: 20rpx;
}

/* 底部常驻横向工具栏 */
.toolbar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 192rpx;
  display: flex;
  background: var(--bg);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 15;
}

.tool {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.tool-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  border: 3rpx solid var(--text-2);
  color: var(--text-2);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.tool-on .tool-icon {
  border-color: var(--accent);
  color: var(--accent);
}

.tool-label {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-2);
}

.tool-on .tool-label { color: var(--accent); }
