.topbar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 16rpx;
}

.top-close {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.65;
}

.top-placeholder { width: 44rpx; height: 44rpx; }

.top-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text);
}

.preview-wrap {
  margin: 0 48rpx 40rpx;
  padding: 16rpx;
  border-radius: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
}

.preview-canvas {
  width: 100%;
  height: 560rpx;
}

.info-card {
  margin: 0 48rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.info-row:last-child { margin-bottom: 0; }

.info-label { font-size: 26rpx; color: var(--text-2); }

.info-value { font-size: 26rpx; color: var(--text); }

.actions {
  margin: 48rpx 48rpx 60rpx;
}

.btn-primary {
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  border-radius: 24rpx;
  background: var(--accent);
  color: var(--on-accent);
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.btn-secondary {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  color: var(--text);
  font-size: 28rpx;
}

.tap { opacity: 0.85; }
