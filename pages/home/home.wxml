<view class="root {{'t-' + theme}}">
  <view class="page-pad">
    <!-- 标题栏 -->
    <view class="title-row">
      <text class="h1">图库</text>
      <view class="gear" hover-class="tap">⚙</view>
    </view>

    <!-- 新建编辑 -->
    <view class="cta" hover-class="tap" bindtap="openEditor">+ 新建编辑</view>

    <!-- 继续编辑卡 -->
    <view wx:if="{{lastProject}}" class="continue" hover-class="tap" bindtap="continueEdit">
      <image class="continue-thumb" src="{{lastProject.image}}" mode="aspectFill" />
      <view class="continue-text">
        <text class="continue-title">继续编辑</text>
        <text class="continue-sub">上次编辑 · 有点意思</text>
      </view>
      <text class="chevron">›</text>
    </view>

    <!-- 3 列照片网格 -->
    <view wx:if="{{photos.length}}" class="grid">
      <view
        wx:for="{{photos}}"
        wx:key="*this"
        class="cell"
        hover-class="tap"
        data-src="{{item}}"
        bindtap="openPhoto"
      >
        <image class="cell-img" src="{{item}}" mode="aspectFill" />
      </view>
    </view>
    <view wx:else class="empty">
      <text class="empty-text">从相册选择照片开始编辑</text>
    </view>
  </view>
</view>
