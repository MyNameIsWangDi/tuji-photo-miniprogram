.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 24rpx;
}

.gear {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cta {
  height: 104rpx;
  border-radius: 24rpx;
  background: var(--accent);
  color: var(--on-accent);
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.continue {
  margin-top: 24rpx;
  height: 128rpx;
  border-radius: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.continue-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: var(--hairline);
}

.continue-text {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.continue-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text);
}

.continue-sub {
  font-size: 22rpx;
  color: var(--text-2);
}

.chevron {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
}

.grid {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cell {
  width: calc((100% - 16rpx) / 3);
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--surface);
}

.cell-img {
  width: 100%;
  height: 100%;
}

.empty {
  margin-top: 120rpx;
  text-align: center;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-3);
}

.tap {
  opacity: 0.85;
}

/* 底部 pill 标签栏 */
.tabbar {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: 24rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: var(--hairline);
  opacity: 0.92;
  display: flex;
  align-items: center;
  padding: 12rpx;
  box-sizing: border-box;
}

.tab {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-on { background: var(--accent); }

.tab-text { font-size: 26rpx; color: var(--text-2); }

.tab-text-on { color: var(--on-accent); font-weight: 500; }
