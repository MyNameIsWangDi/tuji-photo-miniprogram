.card {
  margin-top: 24rpx;
  border-radius: 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
}

.appearance {
  display: flex;
  align-items: center;
  padding: 28rpx;
}

.swatch {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--hairline);
}

.card-text {
  flex: 1;
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-title { font-size: 28rpx; font-weight: 500; color: var(--text); }

.card-sub { font-size: 22rpx; color: var(--text-2); }

.chevron {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.55;
}

.stats {
  display: flex;
  justify-content: space-evenly;
  padding: 28rpx 0;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value { font-size: 40rpx; font-weight: 700; color: var(--text); }

.stat-label { font-size: 22rpx; color: var(--text-2); }

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.version {
  display: block;
  text-align: center;
  margin-top: 48rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

/* 底部 pill 标签栏 */
.tabbar {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: 24rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: var(--hairline);
  opacity: 0.92;
  display: flex;
  align-items: center;
  padding: 12rpx;
  box-sizing: border-box;
}

.tab {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-on {
  background: var(--accent);
}

.tab-text { font-size: 26rpx; color: var(--text-2); }

.tab-text-on { color: var(--on-accent); font-weight: 500; }

.tap { opacity: 0.85; }
