.project {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
}

.thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: var(--hairline);
}

.project-text {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.project-title { font-size: 28rpx; font-weight: 500; color: var(--text); }

.project-sub { font-size: 22rpx; color: var(--text-2); }

.chevron {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.55;
}

.empty {
  margin-top: 200rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.empty-title { font-size: 28rpx; color: var(--text-2); }

.empty-sub { font-size: 22rpx; color: var(--text-3); }

/* 底部 pill 标签栏 */
.tabbar {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: 24rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: var(--hairline);
  opacity: 0.92;
  display: flex;
  align-items: center;
  padding: 12rpx;
  box-sizing: border-box;
}

.tab {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-on { background: var(--accent); }

.tab-text { font-size: 26rpx; color: var(--text-2); }

.tab-text-on { color: var(--on-accent); font-weight: 500; }

.tap { opacity: 0.85; }
