.cats {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0 24rpx;
}

.chip {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  font-size: 24rpx;
  color: var(--text-2);
}

.chip-on {
  background: var(--accent);
  color: var(--on-accent);
  border-color: var(--accent);
  font-weight: 500;
}

.tpl-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.tpl-card {
  width: calc((100% - 24rpx) / 2);
  border-radius: 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  overflow: hidden;
}

.tpl-cover {
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tpl-cover-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
}

.tpl-info { padding: 24rpx; display: flex; flex-direction: column; gap: 6rpx; }

.tpl-name { font-size: 26rpx; font-weight: 500; color: var(--text); }

.tpl-tag { font-size: 22rpx; color: var(--text-3); }

.sec-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0 20rpx;
}

.sec-label { font-size: 26rpx; color: var(--text-2); }

.sec-count { font-size: 22rpx; color: var(--text-3); }

.theme-scroll { white-space: nowrap; }

.theme-row { display: inline-flex; gap: 20rpx; }

.theme-card {
  width: 208rpx;
  height: 128rpx;
  border-radius: 24rpx;
  background: var(--surface);
  border: 2rpx solid var(--hairline);
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.theme-on { border-color: var(--accent); border-width: 3rpx; }

.swatch {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--hairline);
  flex-shrink: 0;
}

.theme-text { display: flex; flex-direction: column; gap: 4rpx; overflow: hidden; }

.theme-name { font-size: 24rpx; font-weight: 500; color: var(--text); }

.theme-desc {
  font-size: 20rpx;
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tap { opacity: 0.85; }

/* 底部 pill 标签栏 */
.tabbar {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: 24rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: var(--hairline);
  opacity: 0.92;
  display: flex;
  align-items: center;
  padding: 12rpx;
  box-sizing: border-box;
}

.tab {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-on { background: var(--accent); }

.tab-text { font-size: 26rpx; color: var(--text-2); }

.tab-text-on { color: var(--on-accent); font-weight: 500; }

.tpl-cover-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.tpl-cover-tint {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0.24;
}
